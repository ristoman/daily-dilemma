  "hypotheses": [
    {
      "id": "hyp-manual-001",
      "createdAt": "2026-02-17",
      "source": "manual",
      "statement": "We believe adding a like button to dilemmas will increase engagement, measurable by likes per vote and return rate",
      "rationale": "A lightweight like action after voting gives users a way to signal content quality. Tracking like rate per dilemma provides a content quality metric and increases interaction depth per session.",
      "status": "running",
      "targetGoal": "returnRate",
      "experimentId": "exp-74403",
      "result": null,
      "metrics": {}
    },
    {
      "id": "hyp-manual-002",
      "createdAt": "2026-02-17",
      "source": "manual",
      "statement": "We believe adding a skip button to dilemmas will increase vote completion rate, measurable by vote_cast / pageview ratio",
      "rationale": "Users who don't connect with a dilemma currently bounce. A skip button keeps them in the flow and moves them to a dilemma they care about, converting would-be bounces into votes.",
      "status": "proposed",
      "targetGoal": "voteCompletionRate",
      "experimentId": null,
      "result": null,
      "metrics": {},
      "designNotes": {
        "skipBehavior": "One-tap skip, do not resurface the skipped dilemma for that session",
        "afterSkip": "Show results view (vote percentages, total votes) without highlighting a choice",
        "publicVisibility": "Do not show skip count publicly — track internally for content quality signals",
        "analytics": "Track dilemma_skipped event in PostHog with dilemma ID",
        "feedsInto": "Skip data feeds into weekly-scan and dilemma generation (hyp-manual-004)"
      }
    },
    {
      "id": "hyp-manual-003",
      "createdAt": "2026-02-17",
      "source": "manual",
      "statement": "We believe a Top 10 most liked dilemmas page will increase return rate, measurable by sessions with >1 pageview",
      "rationale": "Once enough likes accumulate, a curated 'best of' page gives returning users a reason to come back beyond the daily question. Requires hyp-manual-001 (likes) to be shipped first.",
      "status": "proposed",
      "targetGoal": "returnRate",
      "experimentId": null,
      "result": null,
      "metrics": {},
      "dependsOn": "hyp-manual-001"
    },
    {
      "id": "hyp-exp-001",
      "createdAt": "2026-02-25",
      "source": "manual",
      "statement": "We believe showing a teaser of the next dilemma on the results screen will increase the rate of users answering a second dilemma, measurable by keep_going_clicked / results_viewed",
      "rationale": "85% of users drop off after the first dilemma. Replacing the generic 'Keep going' button with a preview of the next question removes the unknown and creates curiosity-driven pull.",
      "status": "running",
      "targetGoal": "secondPageRate",
      "experimentId": "exp-74961",
      "result": null,
      "metrics": {}
    },
    {
      "id": "hyp-manual-004",
      "createdAt": "2026-02-17",
      "source": "manual",
      "statement": "We believe feeding like/skip signals into dilemma generation will improve content quality over time, measurable by like ratio and vote completion rate trending upward",
      "rationale": "Like and skip data creates a feedback loop for content generation. Rather than copying popular topics, Claude should identify underlying themes that resonate (e.g. 'nostalgia-driven choices', 'false dichotomies in everyday habits') and generate dilemmas that tap into those patterns while maintaining topical diversity. Requires hyp-manual-001 and hyp-manual-002 to be shipped first.",
      "status": "proposed",
      "targetGoal": "voteCompletionRate",
      "experimentId": null,
      "result": null,
      "metrics": {},
      "dependsOn": [
        "hyp-manual-001",
        "hyp-manual-002"
      ]
    }
  ],
